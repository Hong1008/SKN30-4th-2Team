# 이 파일을 api/.env로 복사한 뒤 실제 비밀값을 입력합니다.
# api/.env는 Git으로 추적하지 않습니다.
OPENAI_API_KEY=
GEMINI_API_KEY=

# RunPod LLM 배포용 API 키입니다. `just` 배포 명령이 api/.env에서 읽으며,
# 애플리케이션 실행에는 사용하지 않습니다. 실제 값은 절대 커밋하지 마세요.
RUNPOD_API_KEY=

# Ollama Pod 배포 설정입니다. `RUNPOD_OLLAMA_IMAGE`은 직접 build/push할 공개 Docker 이미지 태그입니다.
# 예: docker.io/your-dockerhub-id/workshield-ollama:0.1.0
RUNPOD_OLLAMA_IMAGE=
# `just ollama-template-create` 결과의 template ID입니다. Pod 생성 전에 직접 기록합니다.
RUNPOD_OLLAMA_TEMPLATE_ID=
# `just ollama-pod-create` 결과의 Pod ID입니다. 조회·정지·삭제 전에 직접 기록합니다.
RUNPOD_OLLAMA_POD_ID=

GITHUB_TOKEN=