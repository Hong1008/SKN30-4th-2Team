# 이 파일을 api/.env로 복사한 뒤 실제 비밀값을 입력합니다.
# api/.env는 Git으로 추적하지 않습니다.
OPENAI_API_KEY=
GEMINI_API_KEY=

# RunPod Serverless endpoint 배포·호출에 모두 사용하는 API 키입니다.
# Restricted 권한으로 Ollama Serverless endpoint만 허용하세요.
RUNPOD_API_KEY=
# 로컬 검증용 Ollama Pod 배포 설정입니다. Pod proxy에는 별도 인증을 적용하지 않습니다.
# 예: docker.io/your-dockerhub-id/workshield-ollama:0.1.0
RUNPOD_OLLAMA_IMAGE=
# `just ollama-template-create` 결과의 template ID입니다. Pod 생성 전에 직접 기록합니다.
RUNPOD_OLLAMA_TEMPLATE_ID=
# `just ollama-pod-create` 결과의 Pod ID입니다. 조회·정지·삭제 전에 직접 기록합니다.
RUNPOD_OLLAMA_POD_ID=

# 운영 시연용 Ollama Serverless endpoint 설정입니다.
RUNPOD_OLLAMA_SERVERLESS_IMAGE=
RUNPOD_OLLAMA_SERVERLESS_TEMPLATE_ID=
RUNPOD_OLLAMA_ENDPOINT_ID=

# 운영 시연에서 Serverless Ollama를 사용할 때 설정합니다. workers-min=0이면 최초 호출은
# 모델 기동 시간을 포함하므로 LLM_TIMEOUT_SECONDS를 Serverless execution timeout 이상으로 둡니다.
# APP_ENV=prod
# LLM_PROVIDER=runpod_serverless
# LLM_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# LLM_TIMEOUT_SECONDS=600

# local 검증용 Ollama Pod URL입니다.
OLLAMA_BASE_URL=
GITHUB_TOKEN=
