# 이 파일을 api/.env로 복사한 뒤 실제 비밀값을 입력합니다.
# api/.env는 Git으로 추적하지 않습니다.
OPENAI_API_KEY=
GEMINI_API_KEY=

# vLLM OpenAI-compatible server 접속 정보입니다.
# VLLM_BASE_URL은 origin과 /v1 API root를 모두 허용합니다.
VLLM_BASE_URL=
VLLM_API_KEY=

# RunPod Serverless endpoint 호출 전용 키입니다.
# Pod 생성·삭제 권한이 있는 RUNPOD_MANAGEMENT_API_KEY를 넣지 마세요.
RUNPOD_SERVERLESS_API_KEY=
RUNPOD_OLLAMA_ENDPOINT_ID=

# SQLite·프로세스 내부 큐는 API worker 1개를 전제로 합니다.
API_WORKER_COUNT=1
SQLITE_BUSY_TIMEOUT_MS=5000

# 운영 vLLM 예시입니다.
# APP_ENV=prod
# LLM_PROVIDER=vllm
# LLM_MODEL=<GET /v1/models가 반환하는 model ID>
