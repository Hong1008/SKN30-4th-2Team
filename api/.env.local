# 로컬 개발의 공개 기본값입니다. 실제 API 키는 api/.env에만 둡니다.
# APP_DEBUG와 API_DOCS_ENABLED는 .env.local/.env.prod 기본값을 사용합니다.
APP_ENV=local
APP_DEBUG=true
API_DOCS_ENABLED=true

# 1. OpenAI 사용 시 
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# 2. Gemini / Gemma 사용 시
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_MODEL=gemma-4-31b-it

# 3. Ollama 사용 시 (ollama 스펠링 및 로컬 모델명 지정)
# LLM_PROVIDER=ollama
# LLM_MODEL=hf.co/RedHatAI/Qwen3.5-9B-FP8-dynamic   # 또는 로컬 ollama list 상의 이름 (e.g. Qwen/Qwen3.5-9B)
# OLLAMA_BASE_URL=http://localhost:11434

# 4. vLLM OpenAI-compatible server 사용 시
# LLM_PROVIDER=vllm
# LLM_MODEL=서버의 /v1/models가 반환하는 model ID

# SQLite는 API 프로젝트의 data/workshield.db 파일을 사용합니다.
DATABASE_URL=sqlite+pysqlite:///./data/workshield.db
DATABASE_ECHO=false

# 브라우저 접근을 허용할 프론트엔드 origin을 JSON 배열로 지정합니다.
CORS_ORIGINS=["http://localhost:5173"]

# 자체 호스팅 LLM과 WorkShield MCP 연결 정보입니다.
WORKSHIELD_MCP_TRANSPORT=stdio
WORKSHIELD_MCP_PROJECT_DIR=../mcp
WORKSHIELD_MCP_URL=http://localhost:8000/mcp

# 계약서 업로드·검토 세션 설정
MAX_UPLOAD_SIZE_BYTES=10485760
SUPPORTED_FILE_EXTENSIONS=hwp,hwpx,pdf,docx
TEMP_UPLOAD_DIR=data/99_uploads
SESSION_TTL_SECONDS=1800
STORAGE_CLEANUP_INTERVAL_SECONDS=60
