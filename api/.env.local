# 로컬 개발의 공개 기본값입니다. 실제 API 키는 api/.env에만 둡니다.
# APP_DEBUG와 API_DOCS_ENABLED는 .env.local/.env.prod 기본값을 사용합니다.
APP_ENV=local
APP_DEBUG=true
API_DOCS_ENABLED=true

# 1. OpenAI 사용 시 
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# 2. Gemini / Gemma 사용 시
# 실제 Gemini API 키는 Git에 포함되지 않는 개인용 .env 파일에 입력합니다.
# api/.env: GEMINI_API_KEY=여기에_발급받은_API_키_입력
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_MODEL=gemma-4-31b-it

# 3. Ollama 사용 시 (ollama 스펠링 및 로컬 모델명 지정)
LLM_PROVIDER=ollama
LLM_MODEL=qwen35-local
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 4. vLLM OpenAI-compatible server 사용 시
# LLM_PROVIDER=vllm
# LLM_MODEL=RedHatAI/Qwen3.5-9B-FP8-dynamic

# SQLite는 API 프로젝트의 data/workshield.db 파일을 사용합니다.
DATABASE_URL=sqlite+pysqlite:///./data/workshield.db
DATABASE_ECHO=false

# 브라우저 접근을 허용할 프론트엔드 origin을 JSON 배열로 지정합니다.
CORS_ORIGINS=["http://localhost:5173"]

# WorkShield MCP 연결 정보입니다.
WORKSHIELD_MCP_TRANSPORT=stdio
WORKSHIELD_MCP_PROJECT_DIR=../mcp
WORKSHIELD_MCP_URL=http://localhost:8000/mcp
