# 운영 배포의 공개 기본값입니다. LLM 접속 정보는 api/.env 또는 프로세스 환경에 둡니다.
APP_ENV=prod
APP_DEBUG=false
API_DOCS_ENABLED=false
DATABASE_ECHO=false
LLM_PROVIDER=vllm

# 선택 사항: 질문과 최근 대화 일부만 외부 저지연 분류기로 전달합니다.
ROUTER_LLM_PROVIDER=gemini
ROUTER_LLM_MODEL=gemma-4-31b-it
ROUTER_LLM_TIMEOUT_SECONDS=3

# SQLite는 API 프로젝트의 data/workshield.db 파일을 사용합니다.
DATABASE_URL=sqlite+pysqlite:///./data/workshield.db

# WorkShield MCP 연결 정보입니다.
WORKSHIELD_MCP_TRANSPORT=streamable_http
WORKSHIELD_MCP_URL=http://mcp:8000/mcp
