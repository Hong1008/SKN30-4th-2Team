# 운영 배포의 공개 기본값입니다. 운영에서는 외부 LLM provider를 허용하지 않습니다.
APP_ENV=prod
APP_DEBUG=false
API_DOCS_ENABLED=false
DATABASE_ECHO=false
LLM_PROVIDER=ollama
WORKSHIELD_MCP_TRANSPORT=streamable_http
WORKSHIELD_MCP_URL=http://localhost:8000/mcp

# 계약서 업로드·검토 세션 설정
MAX_UPLOAD_SIZE_BYTES=10485760
SUPPORTED_FILE_EXTENSIONS=hwp,hwpx,pdf,docx
TEMP_UPLOAD_DIR=data/99_uploads
SESSION_TTL_SECONDS=1800
STORAGE_CLEANUP_INTERVAL_SECONDS=60
