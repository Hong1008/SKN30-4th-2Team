server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${ORIGIN_DOMAIN};

    ssl_certificate /opt/workshield/certificates/fullchain.pem;
    ssl_certificate_key /opt/workshield/certificates/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # CloudFront origin-facing prefix list와 함께 적용하는 두 번째 origin 검증이다.
    if ($http_x_workshield_origin != "${ORIGIN_HEADER}") {
        return 403;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $http_x_request_id;

    location = /health/live {
        proxy_pass http://api:8000;
        proxy_cache off;
    }

    location = /health/ready {
        proxy_pass http://api:8000;
        proxy_cache off;
    }

    location /api/ {
        proxy_pass http://api:8000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection "";
    }

    location / {
        return 404;
    }
}
